<!-- Products -->
@using LadowebservisMVC.Models
@model OrderModel

@{
    ViewBag.Title = "Produkty";
    Func<decimal, int> loyaltyPoints = amount => (int)Math.Floor(amount / 10m);
}

<style>
    /* ===== MODERN E-SHOP ===== */
    .products-container {
        max-width: 1320px;
        margin: 0 auto;
        padding: 24px 20px 50px;
        background: #f7f8fc;
    }

    .products-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #24134f 0%, #5d33fb 55%, #7c5cff 100%);
        color: #fff;
        padding: 42px 28px;
        border-radius: 24px;
        text-align: center;
        margin-bottom: 22px;
        box-shadow: 0 18px 45px rgba(71, 45, 160, .22);
    }

        .products-hero::before,
        .products-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            pointer-events: none;
        }

        .products-hero::before {
            width: 260px;
            height: 260px;
            top: -150px;
            left: -80px;
        }

        .products-hero::after {
            width: 330px;
            height: 330px;
            right: -140px;
            bottom: -190px;
        }

        .products-hero h2 {
            position: relative;
            z-index: 1;
            font-size: clamp(24px, 3vw, 34px);
            line-height: 1.2;
            font-weight: 800;
            margin: 0;
            letter-spacing: -.5px;
            text-shadow: none;
        }

        .products-hero p {
            position: relative;
            z-index: 1;
            max-width: 760px;
            margin-left: auto !important;
            margin-right: auto !important;
        }

    .shop-toolbar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        background: #fff;
        border: 1px solid #e9eaf2;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(30, 35, 60, .06);
        margin-bottom: 22px;
    }

    .shop-search {
        flex: 1;
        position: relative;
    }

        .shop-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #8b8fa3;
            pointer-events: none;
        }

        .shop-search input {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #e1e3ec;
            border-radius: 12px;
            padding: 12px 15px 12px 42px;
            font-size: 14px;
            outline: none;
            background: #fafbfe;
            transition: .2s ease;
        }

            .shop-search input:focus {
                border-color: #7658ff;
                background: #fff;
                box-shadow: 0 0 0 4px rgba(93,51,251,.10);
            }

    .shop-toolbar-note {
        color: #6d7183;
        font-size: 13px;
        white-space: nowrap;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .product-card {
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e8e9f0;
        border-radius: 20px;
        padding: 18px;
        margin: 0;
        box-shadow: 0 8px 25px rgba(31, 35, 58, .07);
        transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
            border-color: #d9d4ff;
            box-shadow: 0 16px 38px rgba(31, 35, 58, .12);
        }

        .product-card.is-favorited {
            border-color: #ffb8c2;
        }

    .product-image-container {
        order: -1;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 220px;
        margin: -2px -2px 10px;
        border-radius: 15px;
        background: linear-gradient(180deg, #fafaff 0%, #f4f5fb 100%);
        overflow: hidden;
        position: relative;
    }

        .product-image-container a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .product-image-container img {
            display: block;
            max-width: 88%;
            max-height: 200px;
            width: auto;
            height: auto;
            object-fit: contain;
            border-radius: 10px;
            box-shadow: none;
            transition: transform .3s ease;
        }

    .product-card:hover .product-image-container img {
        transform: scale(1.045);
    }

    .product-heart-btn {
        position: absolute;
        top: 27px;
        right: 27px;
        left: auto;
        width: 38px;
        height: 38px;
        padding: 0;
        border: 1px solid #e6e7ef;
        border-radius: 50%;
        background: rgba(255,255,255,.94);
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
        font-size: 17px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 15;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .product-heart-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 7px 18px rgba(0,0,0,.13);
        }

    .product-badge {
        position: absolute;
        top: 27px;
        left: 27px;
        right: auto;
        background: #ff4f64;
        color: #fff;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .3px;
        text-transform: uppercase;
        z-index: 10;
        box-shadow: 0 5px 12px rgba(255,79,100,.22);
    }

        .product-badge.discount {
            background: #17a673;
        }

        .product-badge.new {
            background: #ff8a00;
        }

    .product-header {
        text-align: left;
        margin: 0 0 8px;
        min-height: 48px;
        display: flex;
        align-items: center;
    }

        .product-header h2 {
            color: #20233a;
            font-size: 19px;
            line-height: 1.3;
            font-weight: 750;
            margin: 0;
            letter-spacing: -.2px;
        }

    .product-description {
        background: transparent;
        border: 0;
        padding: 0;
        margin: 0 0 12px;
        min-height: 42px;
        font-size: 13px;
        line-height: 1.55;
        color: #686c7c;
    }

    .discount-notice {
        background: #fff7df;
        color: #765800;
        padding: 8px 10px;
        border: 1px solid #f7e5a9;
        border-radius: 10px;
        text-align: left;
        margin: 0 0 12px;
        font-size: 12px;
        line-height: 1.4;
        font-weight: 600;
        box-shadow: none;
    }

    .product-pricing {
        text-align: left;
        margin: 4px 0 4px;
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 7px;
    }

    .price-original {
        font-size: 14px;
        color: #999eaf;
        text-decoration: line-through;
        margin-right: 0;
    }

    .price-current {
        font-size: 27px;
        color: #20233a;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .price-save {
        display: inline-block;
        background: #e7f8ef;
        color: #16845d;
        padding: 4px 8px;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 800;
        margin-left: 0;
    }

    .loyalty-points-note {
        margin-top: 4px;
        font-size: 11px;
        font-weight: 600;
        color: #777b8d;
    }

        .loyalty-points-note strong {
            color: #5d33fb;
        }

    .product-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin: 14px 0 0;
        margin-top: auto;
        padding-top: 14px;
    }

    .btn-stripe,
    .btn-add-cart,
    .btn-google-pay,
    .btn-view-cart {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        min-height: 42px;
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
    }

    .btn-stripe {
        background: #635bff;
        color: #fff;
        border: 1px solid #635bff;
        box-shadow: 0 5px 14px rgba(99,91,255,.20);
    }

        .btn-stripe:hover {
            background: #5148e8;
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-add-cart {
        background: #20233a;
        color: #fff;
        border: 1px solid #20233a;
    }

        .btn-add-cart:hover {
            background: #111325;
            transform: translateY(-1px);
        }

    .btn-google-pay {
        background: #f5f6fa;
        color: #3d4050;
        border: 1px solid #e2e4ec;
        box-shadow: none;
    }

        .btn-google-pay:hover,
        .btn-view-cart:hover {
            background: #eceef5;
            color: #20233a;
            transform: translateY(-1px);
            box-shadow: none;
        }

        .btn-google-pay small {
            display: inline;
            font-size: 9px;
            font-weight: 500;
            opacity: .7;
            line-height: 1;
        }

    .btn-view-cart {
        background: #fff;
        color: #5d33fb;
        border: 1px solid #dcd7ff;
    }

    .product-details {
        margin-top: 12px;
        border-top: 1px solid #ececf2;
        padding-top: 10px;
    }

        .product-details summary {
            background: transparent;
            padding: 4px 0;
            border-radius: 0;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            color: #6861bd;
            transition: color .2s ease;
        }

            .product-details summary:hover {
                color: #4b3de0;
            }

        .product-details p {
            padding: 10px 0 0;
            line-height: 1.6;
            color: #6b6e7d;
            background: transparent;
            border-radius: 0;
            margin: 0;
            font-size: 12px;
        }

    .product-match {
        outline: 3px solid #5d33fb;
        box-shadow: 0 0 0 5px rgba(93,51,251,.12), 0 16px 38px rgba(31,35,58,.12);
    }

    .product-hidden {
        display: none !important;
    }

    .search-spinner-overlay {
        position: fixed;
        inset: 0;
        background: rgba(17, 19, 37, .35);
        backdrop-filter: blur(3px);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        opacity: 0;
        transition: opacity .25s ease;
    }

        .search-spinner-overlay.show {
            display: flex;
            opacity: 1;
        }

    .spinner-container {
        background: #fff;
        padding: 26px;
        border-radius: 16px;
        box-shadow: 0 15px 45px rgba(0,0,0,.18);
        text-align: center;
        max-width: 300px;
    }

    .spinner {
        border: 4px solid #ececf4;
        border-top: 4px solid #5d33fb;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        animation: spin 1s linear infinite;
        margin: 0 auto 14px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .spinner-text {
        font-size: 14px;
        color: #555;
        font-weight: 600;
        margin: 0;
    }

        .spinner-text.sub {
            font-size: 12px;
            color: #999;
            margin-top: 7px;
            font-weight: normal;
        }

    @@media (max-width: 900px) {
        .products-grid {
            grid-template-columns: 1fr;
        }

        .product-card {
            max-width: 680px;
            width: 100%;
            margin-left: auto;
            margin-right: auto;
        }
    }

    @@media (max-width: 600px) {
        .products-container {
            padding: 12px 10px 35px;
        }

        .products-hero {
            padding: 30px 17px;
            border-radius: 18px;
        }

            .products-hero h2 {
                font-size: 23px;
            }

            .products-hero p {
                font-size: 13px !important;
            }

        .shop-toolbar {
            padding: 10px;
        }

        .shop-toolbar-note {
            display: none;
        }

        .product-card {
            padding: 14px;
            border-radius: 17px;
        }

        .product-image-container {
            height: 190px;
        }

            .product-image-container img {
                max-height: 175px;
            }

        .product-header {
            min-height: auto;
        }

            .product-header h2 {
                font-size: 18px;
            }

        .product-actions {
            grid-template-columns: 1fr;
        }

        .price-current {
            font-size: 25px;
        }

        .product-badge {
            top: 21px;
            left: 21px;
        }

        .product-heart-btn {
            top: 21px;
            right: 21px;
        }
    }

    .product-image-container {
        position: relative;
    }

    .image-discount-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        padding: 7px 11px;
        border-radius: 999px;
        background: #e53935;
        color: #fff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .2px;
        box-shadow: 0 5px 14px rgba(0,0,0,.16);
    }

    /* ===== EMOTIONAL / SENSORY SHOP UPGRADE ===== */
    .lws-emotion-strip { display:flex; flex-wrap:wrap; justify-content:center; gap:10px; margin:-8px auto 20px; }
    .lws-emotion-strip span { background:rgba(255,255,255,.92); border:1px solid #ece8ff; border-radius:999px; padding:8px 13px; color:#4b4668; font-size:12px; font-weight:700; box-shadow:0 6px 18px rgba(50,40,90,.06); }
    .products-hero { padding:50px 28px 44px; }
    .products-hero h2 { font-size:clamp(27px,3.4vw,40px); }
    .products-hero p:first-of-type { font-size:18px !important; line-height:1.65; }
    .products-hero::after { opacity:.65; }
    .product-card { border-radius:22px; }
    .product-card:hover { transform:translateY(-6px); }
    .product-description { font-size:14px; color:#555b70; }
    .product-description::first-letter { font-size:1.08em; }
    .product-actions button, .product-actions a { transition:transform .18s ease, box-shadow .18s ease; }
    .product-actions button:hover, .product-actions a:hover { transform:translateY(-2px); }
    @*@media(max-width:700px){ .lws-emotion-strip{gap:6px}.lws-emotion-strip span{font-size:11px;padding:7px 10px}.products-hero{padding:36px 18px 32px} }*@
</style>

<div class="products-container">
    <!-- Hero Header -->
    <div class="products-hero">
        <h2 style="color: white;">🛍️ VITAJTE! POZRITE SI NAŠU AKTUÁLNU PONUKU</h2>
        <p style="margin-top: 15px; font-size: 16px; color: white;">Vyberte si z našej ponuky produktov pre každodennú starostlivos o zdravie, energiu a imunitu.</p>
        <p style="margin-top: 12px; font-size: 14px; color: white;">🍂 Jesenna ponuka: na vybrane produkty ziskate 10 % zlavu s kodom <strong>Jesenjetu26</strong>.</p>
    </div>

    <div class="lws-emotion-strip"><span>💚 Starostlivosť, ktorú cítiš každý deň</span><span>✨ Vyber si svoju rutinu</span><span>🎁 Dopraj si niečo pre seba</span></div>

    <!-- Loading Spinner -->
    <div id="searchSpinnerOverlay" class="search-spinner-overlay">
        <div class="spinner-container">
            <div class="spinner"></div>
            <p class="spinner-text">Hľadám produkty...</p>
            <p class="spinner-text sub">Čakajte prosím</p>
        </div>
    </div>

    <!-- Modern shop toolbar -->
    <div class="shop-toolbar">
        <form class="shop-search" method="get" action="@Url.Action("Produkty","Home")">
            <i class="fa fa-search"></i>
            <input type="search" name="q" value="@Request.QueryString["q"]" placeholder="Hľadať produkt, napr. BalanceOil, kolagén, vitamín D..." aria-label="Hľadať produkt">
        </form>
        <div class="shop-toolbar-note"><i class="fa fa-shield"></i> Bezpečný nákup &nbsp;•&nbsp; <i class="fa fa-star"></i> Vernostné body</div>
    </div>

    <div class="products-grid">
        <!-- Product 1: BalanceOil+ Orange 300ml (61,00€ → 54,90€) -->
        <section class="product-card products" id="product-1" data-product-id="1" data-product-name="BalanceOil" data-product-aliases="balance oil,balanceoil,balance oil orange,orange" data-product-image='@Url.Content("~/Image/BalanceOil.png")'>
            <button class="product-heart-btn" onclick="toggleProductFavorite(event, '1', 'BalanceOil', '@Url.Content("~/Image/BalanceOil.png")', 54.90)" title="Pridať do obľúbených" aria-label="Pridať do obľúbených">❤️</button>

            <span class="product-badge discount">-10 % ZĽAVA</span>

            <div class="product-header">
                <h2>💊 BalanceOil+ Orange 300ml</h2>
            </div>

            <div class="product-description">
                Náš bestseller! Prémiový Omega-3 olej s extra panenským olivovým olejom.
            </div>

            <div class="discount-notice">
                🍂 Použite kod <strong>Jesenjetu26</strong> pri platbe a ziskajte 10 % zlavu.
            </div>

            <div class="product-pricing">
                <span class="price-original">61,00€</span>
                <span class="price-current">54,90€</span>
                <span class="price-save">Ušetríte 5,49€</span>
            </div>
            <div class="loyalty-points-note">⭐ Po zaplatení získate <strong>@loyaltyPoints(54.90m) bodov</strong> do vernostného programu</div>



            <div class="product-actions">
                <a href="https://buy.stripe.com/8x24gz43I9YS9pifgO4wM08" class="btn-stripe" target="_blank" rel="noopener noreferrer">
                    <i class="fa fa-credit-card"></i> Kúpiť cez Stripe
                </a>
                <a href="@Url.Action("Kosik","Home")" class="btn-google-pay" title="Google Pay UI - pripravene pre buducu integraciu">
                    <i class="fa fa-google"></i> Google Pay <small>Pripravujeme</small>
                </a>
                <button type="button" class="btn-add-cart add-to-cart" data-id="1">
                    <i class="fa fa-shopping-cart"></i> Pridať do košíka
                </button>
                <button type="button" class="btn-view-cart" onclick="openSideCart()" title="Skontrolovať obsah košíka">
                    <i class="fa fa-eye"></i> Košík
                </button>
            </div>

            <div class="product-image-container">
                <a data-fancybox="gallery" href='@Url.Content("~/Image/BalanceOil.png")'>
                    <img src='@Url.Content("~/Image/BalanceOil.png")' alt="BalanceOil">

                </a>
            </div>

            <details class="product-details">
                <summary>📋 Podrobnosti o produkte</summary>
                <p>
                    Podporuje normálne hladiny triglyceridov v krvi, normálny krvný tlak a normálne hladiny vápnika v krvi. Prispieva k normálnej funkcii mozgu (700 mg DHA). Prispieva k normálnemu imunitnému systému (20 µg vitamínu D3). Pomáha udržiavať dostatočné hladiny EPA a DHA vo vašom tele.
                </p>
            </details>
        </section>

        <!-- Product 6: Dávkovacie poháre (12,00€) -->
        <section class="product-card products" id="product-6" data-product-id="6" data-product-name="Davkovacie pohare" data-product-aliases="dávkovacie poháre,davkovacie pohare,pohare,pohár,pohare 10ks" data-product-image='@Url.Content("~/Image/Davkovacie pohare.png")'>
            <button class="product-heart-btn" onclick="toggleProductFavorite(event, '6', 'Davkovacie pohare', '@Url.Content("~/Image/Davkovacie pohare.png")', 12.00)" title="Pridať do obľúbených" aria-label="Pridať do obľúbených">❤️</button>

            <div class="product-header">
                <h2>🥤 Dávkovacie poháre (10ks)</h2>
            </div>

            <div class="product-description">
                Plastové dávkovacie poháre vhodné do umývačky riadov s mierkou v ml.
            </div>

            <div class="product-pricing">
                <span class="price-current">12,00€</span>
            </div>
            <div class="loyalty-points-note">⭐ Po zaplatení získate <strong>@loyaltyPoints(12.00m) bodov</strong> do vernostného programu</div>

            <div class="product-actions">
                <a href="https://buy.stripe.com/8x24gz43I9YS9pifgO4wM08" class="btn-stripe" target="_blank" rel="noopener noreferrer">
                    <i class="fa fa-credit-card"></i> Kúpiť cez Stripe
                </a>
                <a href="@Url.Action("Kosik","Home")" class="btn-google-pay" title="Google Pay UI - pripravene pre buducu integraciu">
                    <i class="fa fa-google"></i> Google Pay <small>Pripravujeme</small>
                </a>
                <button type="button" class="btn-add-cart add-to-cart" data-id="6">
                    <i class="fa fa-shopping-cart"></i> Pridať do košíka
                </button>
                <button type="button" class="btn-view-cart" onclick="openSideCart()" title="Skontrolovať obsah košíka">
                    <i class="fa fa-eye"></i> Košík
                </button>
            </div>

            <div class="product-image-container">
                <a data-fancybox="gallery" href='@Url.Content("~/Image/Davkovacie pohare.png")'>
                    <img src='@Url.Content("~/Image/Davkovacie pohare.png")' alt="Dávkovacie poháre">

                </a>
            </div>

            <details class="product-details">
                <summary>📋 Podrobnosti o produkte</summary>
                <p>Plastové dávkovacie poháre (10ks) vhodné do umývačky riadov s mierkou v ml a tsp (kávová lyžička).</p>
            </details>
        </section>

        <!-- Product 2: Zinobiotic (47,00€ → 42,30€) -->
        <section class="product-card products" id="product-2" data-product-id="2" data-product-name="Zinobiotic" data-product-aliases="zinobiotic,probiotika,probiotiká" data-product-image='@Url.Content("~/Image/Zinobiotic2025.png")'>
            <button class="product-heart-btn" onclick="toggleProductFavorite(event, '2', 'Zinobiotic', '@Url.Content("~/Image/Zinobiotic2025.png")', 42.30)" title="Pridať do obľúbených" aria-label="Pridať do obľúbených">❤️</button>
            <span class="product-badge discount">-10 % ZĽAVA</span>
            <div class="product-header">
                <h2>🦠 Zinobiotic+</h2>
            </div>

