@{
    ViewBag.Title = "Zdravie v rovnováhe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* Sales Page Styles */
    body {
        background: transparent;
    }

    .zdravie-container {
        max-width: 1360px;
        margin: 0 auto;
        padding: 10px 20px 30px;
        margin-top: 12px;
    }

        .zdravie-container section,
        .zdravie-container .row,
        .zdravie-container .special-offer-box,
        .zdravie-container .it-callout,
        .zdravie-container .urgency-banner,
        .zdravie-container .guarantee-box,
        .zdravie-container .trust-badges {
            margin-bottom: 32px;
        }

    .cta-tertiary {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        color: #fff !important;
        padding: 14px 40px;
        font-size: 16px;
        font-weight: 700;
        border-radius: 12px;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 10px 26px rgba(23, 162, 184, 0.22);
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        margin-left: 10px;
    }

        .cta-tertiary:hover {
            background: linear-gradient(135deg, #138496 0%, #0f6674 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(23, 162, 184, 0.45);
            color: #fff !important;
        }

    .it-callout {
        background: linear-gradient(135deg, #ffffff 0%, #f7f9ff 100%);
        border-radius: 18px;
        padding: 35px;
        box-shadow: 0 14px 36px rgba(36, 50, 74, 0.10);
        border: 1px solid rgba(93, 51, 251, 0.12);
        border-left: 5px solid #17a2b8;
        margin: 35px 0 45px 0;
    }

        .it-callout h2 {
            margin-top: 0;
            color: #17a2b8;
            font-weight: 800;
            font-size: 28px;
        }

        .it-callout p {
            color: #5f6f86;
            margin: 10px 0 0 0;
            line-height: 1.75;
            font-size: 15px;
        }

    .it-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 18px;
        margin-top: 20px;
    }

    .it-card {
        background: #fff;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 10px 26px rgba(36, 50, 74, 0.08);
        border: 1px solid rgba(93, 51, 251, 0.10);
        border-top: 4px solid #17a2b8;
        transition: all 0.25s ease;
        height: 100%;
    }

        .it-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(23, 162, 184, 0.18);
        }

        .it-card h4 {
            margin-top: 0;
            color: #2c3e50;
            font-weight: 800;
            font-size: 16px;
        }

        .it-card .it-icon {
            font-size: 30px;
            margin-bottom: 10px;
            display: inline-block;
            color: #17a2b8;
        }

    .it-actions {
        margin-top: 22px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .offer-pack-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 15px;
    }

    .offer-pack-item {
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        border: 1px solid rgba(93, 51, 251, 0.12);
        border-radius: 12px;
        padding: 12px;
        text-align: center;
        box-shadow: 0 8px 18px rgba(36, 50, 74, 0.08);
    }

        .offer-pack-item img {
            max-width: 100%;
            height: 110px;
            object-fit: contain;
            margin-bottom: 8px;
        }

        .offer-pack-item span {
            display: block;
            color: #5d33fb;
            font-size: 13px;
            font-weight: 700;
            line-height: 1.35;
        }

    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 84px 28px;
        text-align: center;
        border-radius: 22px;
        margin-bottom: 40px;
        box-shadow: 0 20px 50px rgba(93, 51, 251, 0.20);
        position: relative;
        overflow: hidden;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255,255,255,0.1) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero-section > * {
            position: relative;
            z-index: 1;
        }

        .hero-section h1 {
            font-size: 48px;
            font-weight: 800;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
            line-height: 1.2;
        }

    .hero-subtitle {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 15px;
        opacity: 0.96;
    }

    .hero-tagline {
        font-size: 18px;
        margin-bottom: 30px;
        opacity: 0.9;
        font-style: italic;
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-offer-highlight {
        background: rgba(255, 255, 255, 0.15);
        border: 2px solid rgba(255, 255, 255, 0.3);
        padding: 20px 30px;
        border-radius: 14px;
        font-size: 16px;
        font-weight: 600;
        margin: 20px auto;
        display: inline-block;
        max-width: 500px;
        backdrop-filter: blur(10px);
    }

    .urgency-timer {
        display: inline-block;
        background: rgba(255, 107, 107, 0.9);
        padding: 10px 20px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 700;
        margin-top: 10px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.8;
        }
    }

    .cta-primary {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: #fff !important;
        padding: 18px 50px;
        font-size: 18px;
        font-weight: 700;
        border-radius: 12px;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 12px 28px rgba(40,167,69,0.28);
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .cta-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.2);
            transition: left 0.3s ease;
        }

        .cta-primary:hover::before {
            left: 100%;
        }

        .cta-primary:hover {
            background: linear-gradient(135deg, #20c997 0%, #17a2b8 100%);
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(40,167,69,0.5);
            color: #fff !important;
        }

    .cta-secondary {
        background: #ff9800;
        color: #fff !important;
        padding: 14px 40px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 12px;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 10px 24px rgba(255, 152, 0, 0.24);
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        margin-left: 10px;
    }

        .cta-secondary:hover {
            background: #ff7c00;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255, 152, 0, 0.5);
            color: #fff !important;
        }

    .section-title {
        color: #5d33fb;
        font-weight: 800;
        margin-bottom: 30px;
        font-size: 36px;
        text-align: center;
        letter-spacing: -0.02em;
    }

    .benefit-card {
        background: #fff;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 28px rgba(36, 50, 74, 0.08);
        margin-bottom: 30px;
        transition: transform 0.3s ease;
        border: 1px solid rgba(93, 51, 251, 0.10);
        border-top: 4px solid #5d33fb;
    }

        .benefit-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

    .benefit-icon {
        font-size: 48px;
        color: #5d33fb;
        margin-bottom: 15px;
    }

    .problem-card {
        background: #fff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 10px 26px rgba(36, 50, 74, 0.08);
        margin-bottom: 20px;
        text-align: center;
        transition: all 0.3s ease;
        border: 1px solid rgba(93, 51, 251, 0.08);
    }

        .problem-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

    .problem-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .testimonial-card {
        background: linear-gradient(135deg, #ffffff 0%, #eef3fb 100%);
        padding: 25px;
        border-radius: 16px;
        border-left: 4px solid #5d33fb;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 24px rgba(36, 50, 74, 0.08);
    }

        .testimonial-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

    .price-badge {
        background: #ffcc00;
        color: #2c3e50;
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 18px;
        font-weight: 700;
        display: inline-block;
        margin: 10px 0;
    }

    .urgency-banner {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
        color: #fff;
        padding: 25px;
        text-align: center;
        border-radius: 16px;
        margin: 30px 0;
        font-weight: 600;
        font-size: 18px;
        box-shadow: 0 14px 32px rgba(255, 107, 107, 0.24);
        border: 2px solid rgba(255, 255, 255, 0.3);
        animation: slideDown 0.5s ease;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .urgency-banner strong {
        font-size: 20px;
        display: block;
        margin-bottom: 8px;
    }

    .urgency-subtext {
        font-size: 14px;
        opacity: 0.95;
    }

    .special-offer-box {
        background: linear-gradient(135deg, #fff5e6 0%, #ffe0b2 100%);
        border: 1px solid rgba(255, 152, 0, 0.30);
        border-radius: 18px;
        padding: 50px;
        box-shadow: 0 18px 42px rgba(255, 152, 0, 0.18);
        margin-bottom: 40px;
        position: relative;
        overflow: hidden;
    }

        .special-offer-box::before {
            content: '🎁';
            position: absolute;
            font-size: 200px;
            opacity: 0.08;
            right: -30px;
            top: -30px;
            transform: rotate(-15deg);
        }

        .special-offer-box * {
            position: relative;
            z-index: 1;
        }

    .offer-header {
        color: #ff9800;
        font-weight: 700;
        margin-bottom: 30px;
        font-size: 28px;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.08);
    }

    .offer-subtitle {
        color: #d97706;
        font-size: 16px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .product-feature-list {
        font-size: 18px;
        color: #2c3e50;
        line-height: 2;
    }

        .product-feature-list li {
            margin-bottom: 12px;
        }

    .stats-row {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        margin: 40px 0;
        gap: 20px;
    }

    .stat-item {
        text-align: center;
        flex: 1;
        min-width: 200px;
        padding: 30px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(36, 50, 74, 0.08);
        border: 1px solid rgba(93, 51, 251, 0.08);
    }

    .stat-number {
        font-size: 48px;
        font-weight: 700;
        color: #5d33fb;
        margin-bottom: 10px;
    }

    .stat-label {
        font-size: 16px;
        color: #666;
    }

    .process-steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
        margin: 40px 0;
    }

    .step-item {
        background: #fff;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(36, 50, 74, 0.08);
        border-top: 4px solid #5d33fb;
        transition: all 0.3s ease;
        border: 1px solid rgba(93, 51, 251, 0.10);
    }

        .step-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

        .step-item strong {
            color: #5d33fb;
            font-size: 18px;
            display: block;
            margin-bottom: 10px;
        }

    .guarantee-box {
        background: linear-gradient(135deg, #e7f3ff 0%, #f0e6ff 100%);
        border: 1px solid rgba(93, 51, 251, 0.22);
        border-radius: 18px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 16px 36px rgba(93, 51, 251, 0.12);
    }

    .faq-item {
        background: #fff;
        padding: 25px;
        border-radius: 16px;
        margin-bottom: 20px;
        box-shadow: 0 10px 24px rgba(36, 50, 74, 0.08);
        border-left: 4px solid #5d33fb;
        border: 1px solid rgba(93, 51, 251, 0.08);
    }

        .faq-item h4 {
            color: #5d33fb;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .faq-item p {
            color: #666;
            margin: 0;
        }

    .trust-badges {
        background: linear-gradient(135deg, #ffffff 0%, #f4f7fb 100%);
        padding: 22px;
        border-radius: 16px;
        text-align: center;
        color: #6d7b90;
        font-size: 14px;
        box-shadow: 0 10px 24px rgba(36, 50, 74, 0.08);
        border: 1px solid rgba(93, 51, 251, 0.08);
    }

    @@media (max-width: 1200px) {
        .special-offer-box {
            padding: 35px;
        }

        .hero-section {
            padding: 60px 20px;
        }

            .hero-section h1 {
                font-size: 40px;
            }

        .offer-header {
            font-size: 24px;
        }
    }

    @@media (max-width: 992px) {
        .special-offer-box {
            padding: 30px;
        }

        .offer-header {
            font-size: 22px;
        }

        .product-feature-list {
            font-size: 15px;
            text-align: left;
        }

            .product-feature-list li {
                margin-bottom: 8px;
            }

        .section-title {
            font-size: 28px;
        }

        .cta-primary {
            padding: 16px 40px;
            font-size: 16px;
        }

        .cta-secondary {
            padding: 12px 30px;
            font-size: 15px;
            margin-left: 5px;
        }
    }

    @@media (max-width: 768px) {
        .hero-section {
            padding: 50px 15px;
            margin-bottom: 30px;
        }

            .hero-section h1 {
                font-size: 26px;
                margin-bottom: 15px;
            }

        .hero-subtitle {
            font-size: 18px;
            margin-bottom: 12px;
        }

        .hero-tagline {
            font-size: 15px;
            margin-bottom: 20px;
        }

        .hero-offer-highlight {
            padding: 15px 20px;
            font-size: 14px;
            margin: 15px auto;
        }

        .cta-primary {
            padding: 14px 30px;
            font-size: 14px;
            width: 100%;
            margin-bottom: 10px;
        }

        .cta-secondary {
            padding: 12px 25px;
            font-size: 13px;
            width: 100%;
            margin-left: 0;
        }

        .cta-tertiary {
            padding: 12px 25px;
            font-size: 13px;
            width: 100%;
            margin-left: 0;
        }

        .section-title {
            font-size: 24px;
        }

        .special-offer-box {
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .offer-header {
            font-size: 20px;
            margin-bottom: 15px;
        }

        .offer-subtitle {
            font-size: 14px;
        }

        .product-feature-list {
            font-size: 14px;
            text-align: left;
        }

            .product-feature-list li {
                margin-bottom: 6px;
            }

        .benefit-card {
            padding: 20px;
        }

        .benefit-icon {
            font-size: 36px;
        }

        .stats-row {
            flex-direction: column;
        }

        .stat-item {
            min-width: 100%;
            padding: 20px;
        }

        .stat-number {
            font-size: 40px;
        }

        .urgency-banner {
            font-size: 14px;
            padding: 15px;
            margin: 20px 0;
        }

            .urgency-banner strong {
                font-size: 16px;
                margin-bottom: 8px;
            }

        .urgency-subtext {
            font-size: 12px;
        }

        .process-steps {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .step-item {
            padding: 20px;
        }

        .guarantee-box {
            padding: 25px;
        }

        .problem-card {
            padding: 20px;
            margin-bottom: 15px;
        }

        .problem-icon {
            font-size: 36px;
        }

        .faq-item {
            padding: 20px;
            margin-bottom: 15px;
        }

        h3 {
            font-size: 18px;
        }

        .trust-badges {
            padding: 15px;
            font-size: 12px;
        }

        .urgency-timer {
            font-size: 12px;
            padding: 8px 15px;
            margin-top: 8px;
        }
    }

    @@media (max-width: 576px) {
        .hero-section {
            padding: 35px 12px;
            margin-bottom: 20px;
        }

            .hero-section h1 {
                font-size: 22px;
                margin-bottom: 10px;
            }

        .hero-subtitle {
            font-size: 16px;
            margin-bottom: 10px;
        }

        .hero-tagline {
            font-size: 13px;
            margin-bottom: 15px;
        }

        .hero-offer-highlight {
            padding: 12px 15px;
            font-size: 12px;
            margin: 12px auto;
        }

        .section-title {
            font-size: 20px;
        }

        .cta-primary {
            font-size: 13px;
            padding: 12px 20px;
            margin-bottom: 8px;
        }

        .cta-secondary {
            font-size: 12px;
            padding: 10px 18px;
        }

        .cta-tertiary {
            font-size: 12px;
            padding: 10px 18px;
        }

        .special-offer-box {
            padding: 20px;
            border-width: 2px;
            margin-bottom: 20px;
        }

        .offer-header {
            font-size: 18px;
            margin-bottom: 12px;
        }

        .offer-subtitle {
            font-size: 12px;
            margin-bottom: 15px;
        }

        .product-feature-list {
            font-size: 13px;
        }

            .product-feature-list li {
                margin-bottom: 5px;
            }

        .benefit-card {
            padding: 15px;
        }

        .benefit-icon {
            font-size: 32px;
        }

        .stat-number {
            font-size: 32px;
        }

        .problem-card {
            padding: 15px;
            margin-bottom: 10px;
        }

        .problem-icon {
            font-size: 32px;
        }

        .step-item {
            padding: 15px;
        }

            .step-item strong {
                font-size: 15px;
            }

            .step-item p {
                font-size: 13px;
            }

        .faq-item {
            padding: 15px;
            margin-bottom: 12px;
        }

            .faq-item h4 {
                font-size: 14px;
            }

            .faq-item p {
                font-size: 12px;
            }

        .guarantee-box {
            padding: 20px;
        }

            .guarantee-box h3 {
                font-size: 16px;
            }

            .guarantee-box p {
                font-size: 14px;
            }

        .trust-badges {
            padding: 12px;
            font-size: 11px;
        }

        .urgency-banner {
            font-size: 12px;
            padding: 12px;
            margin: 15px 0;
        }

            .urgency-banner strong {
                font-size: 14px;
            }

            .urgency-banner > div {
                font-size: 13px;
            }

        .urgency-timer {
            font-size: 11px;
            padding: 6px 12px;
            margin-top: 6px;
        }

        h3 {
            font-size: 16px;
        }

        .zdravie-container {
            padding-left: 10px;
            padding-right: 10px;
            margin-top: 20px;
        }
    }

    @@media (max-width: 480px) {
        .hero-section {
            padding: 30px 10px;
        }

            .hero-section h1 {
                font-size: 20px;
                line-height: 1.3;
            }

        .hero-subtitle {
            font-size: 14px;
        }

        .hero-tagline {
            font-size: 12px;
        }

        .hero-offer-highlight {
            padding: 10px 12px;
            font-size: 11px;
            margin: 10px auto;
        }

        .section-title {
            font-size: 18px;
            margin-bottom: 15px;
        }

        .cta-primary {
            font-size: 12px;
            padding: 10px 15px;
        }

        .cta-secondary {
            font-size: 11px;
            padding: 8px 15px;
        }

        .special-offer-box {
            padding: 15px;
            margin-bottom: 15px;
        }

        .offer-header {
            font-size: 16px;
        }

        .price-badge {
            font-size: 14px;
            padding: 6px 15px;
        }

        .urgency-banner {
            font-size: 11px;
            padding: 10px;
        }

        .zdravie-container {
            padding-left: 8px;
            padding-right: 8px;
            margin-top: 15px;
        }
    }

    /* Modern health-page sections and new products */
    .health-kicker {
        color: #17745f;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .14em;
        line-height: 1.4;
        margin: 0 auto 12px;
        text-transform: uppercase;
    }

    .hero-section .hero-kicker {
        display: table;
        padding: 8px 13px;
        border: 1px solid rgba(255,255,255,.34);
        border-radius: 999px;
        background: rgba(255,255,255,.12);
        color: #fff;
    }

    .health-hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px;
