<script>
    (function () {
        // Keep anchor navigation smooth without interfering with product/cart controls.
        document.querySelectorAll('a[href="#special-offer"], a[href="#nove-produkty"]').forEach(function (link) {
            link.addEventListener('click', function (event) {
                var target = document.querySelector(link.getAttribute('href'));
                if (!target) return;
                event.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    })();
</script>

































