@using System
@using System.Globalization
@{
    ViewBag.Title = "Stav objednávky";
    var msg = (ViewBag.OrderSentMessage as string) ?? "";
    var name = (ViewBag.OrderSentName as string) ?? "";
    var email = (ViewBag.OrderSentEmail as string) ?? "";
    var total = (ViewBag.OrderSentGrandTotal as string) ?? "";
    var orderNumber = (ViewBag.OrderSentOrderNumber as string) ?? "";
    var hasSummary = !string.IsNullOrWhiteSpace(name) || !string.IsNullOrWhiteSpace(email) || !string.IsNullOrWhiteSpace(total) || !string.IsNullOrWhiteSpace(orderNumber);

    // Rozlisujeme uspesne odoslanie od upozornenia podla spravy z kontrolera.
    var isSuccess = msg.StartsWith("Objednávka bola odoslaná.", StringComparison.OrdinalIgnoreCase)
        || msg.StartsWith("Platobná relácia Stripe bola vytvorená.", StringComparison.OrdinalIgnoreCase);
    var isWarning = !isSuccess;
    var title = isSuccess ? "Objednávka bola odoslaná" : "Objednávku sa nepodarilo potvrdiť";
    var icon = isSuccess ? "✓" : "!";
    var displayedMessage = string.IsNullOrWhiteSpace(msg)
        ? "Stav objednávky sa nepodarilo overiť. Kontaktujte nás, prosím."
        : msg;

    decimal parsedTotal;
    var validTotal = decimal.TryParse(total, NumberStyles.Number, CultureInfo.InvariantCulture, out parsedTotal)
        || decimal.TryParse(total, NumberStyles.Number, new CultureInfo("sk-SK"), out parsedTotal);
    var displayTotal = validTotal ? parsedTotal.ToString("N2", new CultureInfo("sk-SK")) : total;
    var conversionValue = validTotal ? parsedTotal.ToString(CultureInfo.InvariantCulture) : "";
    var trackConversion = isSuccess && validTotal && parsedTotal > 0 && !string.IsNullOrWhiteSpace(orderNumber);
}
<style>
    .order-status-container {
        max-width: 800px;
        margin: 60px auto;
        padding: 0 20px;
    }

    .order-status-box {
        background: linear-gradient(135deg,#f0fff4,#e8f5e9);
        border: 3px solid #28a745;
        border-radius: 12px;
        padding: 48px 40px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(40,167,69,.15);
    }

        .order-status-box.warning {
            background: linear-gradient(135deg,#fff8e1,#fff3cd);
            border-color: #ff9800;
            box-shadow: 0 15px 40px rgba(255,152,0,.12);
        }

    .order-status-icon {
        font-size: 70px;
        font-weight: 700;
        color: #28a745;
        line-height: 1.2;
    }

    .order-status-box.warning .order-status-icon, .order-status-box.warning h2 {
        color: #b65c00;
    }

    .order-status-box h2 {
        font-size: 32px;
        color: #208b3a;
        line-height: 1.3;
        margin: 12px 0 18px;
    }

    .order-status-subtitle {
        color: #24324a;
        font-size: 18px;
        font-weight: 600;
        line-height: 1.6;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 18px;
    }

    .order-status-details {
        background: white;
        border-left: 4px solid #28a745;
        border-radius: 8px;
        padding: 25px;
        text-align: left;
        margin: 28px 0;
        box-shadow: 0 4px 12px rgba(0,0,0,.07);
    }

    .warning .order-status-details {
        border-left-color: #ff9800;
    }

    .order-status-details h4 {
        color: #5d33fb;
        font-size: 17px;
        font-weight: 700;
        margin: 0 0 15px;
    }

    .order-status-details p {
        color: #24324a;
        line-height: 1.7;
        margin: 10px 0;
        overflow-wrap: anywhere;
    }

    .order-status-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    .order-status-btn {
        display: inline-block;
        border-radius: 8px;
        padding: 14px 25px;
        color: white !important;
        text-decoration: none !important;
        font-weight: 700;
    }

    .order-status-primary {
        background: #5d33fb;
    }

    .order-status-secondary {
        background: #138da2;
    }

    @@media (max-width: 600px) {
        .order-status-box {
            padding: 28px 16px;
        }

            .order-status-box h2 {
                font-size: 25px;
            }

        .order-status-actions {
            flex-direction: column;
        }
    }
</style>
<div class="order-status-container">
    <div class="order-status-box @(isWarning ? "warning" : "")">
        <div class="order-status-icon" aria-hidden="true">@icon</div>
        <h2>@title</h2>
        <p class="order-status-subtitle">@displayedMessage</p>
        <div class="order-status-details">
            @if (isSuccess)
            {
                <h4>Ďalšie kroky</h4>
                <p><strong>1.</strong> Skontrolujte e-mail s platobnými údajmi a prípadný priečinok SPAM.</p>
                <p><strong>2.</strong> Zaplaťte podľa doručených pokynov. Po prijatí platby objednávku spracujeme.</p>
                <p><strong>Neprišiel vám e-mail?</strong> Počkajte 5–10 minút, skontrolujte SPAM a potom nás kontaktujte.</p>
            }
            else
            {
                <h4>Čo robiť ďalej</h4>
                <p>Objednávka nie je potvrdená. <strong>Neodosielajte platbu</strong> a nevytvárajte ďalšiu objednávku bez overenia.</p>
                <p>Kontaktujte nás a uveďte prípadné číslo objednávky.</p>
            }
            <p><a href="@Url.Action("Kontakt", "Home")">Kontaktný formulár</a> alebo <a href="mailto:info@ladowebservis.sk">info@ladowebservis.sk</a></p>
            @if (hasSummary)
            {
                <hr />
                <h4>Súhrn</h4>
                if (!string.IsNullOrWhiteSpace(name))
                {
                    <p>Meno: <strong>@name</strong></p>
                }
                if (!string.IsNullOrWhiteSpace(orderNumber))
                {
                    <p>Číslo objednávky: <strong>@orderNumber</strong></p>
                }
                if (!string.IsNullOrWhiteSpace(email))
                {
                    <p>E-mail: <strong>@email</strong></p>
                }
                if (!string.IsNullOrWhiteSpace(total))
                {
                    <p>Suma na úhradu: <strong>@displayTotal €</strong></p>
                }
            }
        </div>
        <div class="order-status-actions">
            <a class="order-status-btn order-status-primary" href="@Url.Action("Produkty", "Home")">Pokračovať na produkty</a>
            <a class="order-status-btn order-status-secondary" href="@Url.Action("Kosik", "Home")">Späť do košíka</a>
        </div>
    </div>
</div>
@if (trackConversion)
{
    <div id="order-conversion-data" hidden="hidden" data-order-id="@orderNumber" data-order-value="@conversionValue"></div>
    <script type="text/javascript">
        (function () {
            var dataElement = document.getElementById('order-conversion-data');
            if (!dataElement || typeof trackGoogleAdsConversion !== 'function') {
                return;
            }
            try {
                var orderValue = Number(dataElement.getAttribute('data-order-value'));
                var orderId = dataElement.getAttribute('data-order-id');
                if (isFinite(orderValue) && orderValue > 0 && orderId) {
                    trackGoogleAdsConversion(orderId, orderValue, 'EUR');
                }
            } catch (e) {
                if (window.console && console.error) {
                    console.error('Order conversion tracking failed:', e);
                }
            }
        }());
    </script>
}