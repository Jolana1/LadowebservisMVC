@{
    ViewBag.Title = "Subscribe";
}

<style>
    /* ========== SUBSCRIBE PAGE STYLES ========== */
    .subscribe-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        min-height: calc(100vh - 200px);
    }

    /* ========== HERO SECTION ========== */
    .subscribe-hero {
        background: linear-gradient(135deg, #5d33fb 0%, #4a2fb5 100%);
        color: #fff;
        padding: 50px 30px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 40px;
        box-shadow: 0 10px 30px rgba(93, 51, 251, 0.3);
    }

        .subscribe-hero i {
            font-size: 64px;
            margin-bottom: 20px;
            opacity: 0.9;
        }

        .subscribe-hero h1 {
            font-size: 36px;
            font-weight: 700;
            margin: 0 0 15px 0;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .subscribe-hero p {
            font-size: 18px;
            opacity: 0.95;
            margin: 0;
        }

    /* ========== CONTENT CARD ========== */
    .subscribe-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        padding: 40px;
        margin-bottom: 30px;
    }

        .subscribe-card h2 {
            color: #5d33fb;
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 20px 0;
        }

        .subscribe-card p {
            color: #555;
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 20px;
        }

    /* ========== STATUS MESSAGES ========== */
    .status-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: #fff;
        padding: 25px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 30px;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }

        .status-success i {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .status-success h3 {
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 10px 0;
        }

        .status-success p {
            font-size: 16px;
            margin: 0;
            opacity: 0.95;
        }

    .status-error {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: #fff;
        padding: 25px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 30px;
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
    }

        .status-error i {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .status-error h3 {
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 10px 0;
        }

        .status-error p {
            font-size: 16px;
            margin: 0;
            opacity: 0.95;
        }

    /* ========== INFO BOXES ========== */
    .info-box {
        background: #f8f9fa;
        border-left: 4px solid #5d33fb;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .info-box h4 {
            color: #5d33fb;
            font-size: 18px;
            font-weight: 600;
            margin: 0 0 10px 0;
        }

        .info-box ul {
            margin: 0;
            padding-left: 20px;
        }

            .info-box ul li {
                color: #555;
                padding: 5px 0;
            }

    /* ========== BUTTONS ========== */
    .btn-primary-custom {
        background: linear-gradient(135deg, #5d33fb 0%, #4a2fb5 100%);
        color: #fff;
        padding: 15px 40px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 6px 20px rgba(93, 51, 251, 0.3);
        border: none;
        cursor: pointer;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(93, 51, 251, 0.4);
            color: #fff;
            text-decoration: none;
        }

    .btn-secondary-custom {
        background: #f8f9fa;
        color: #5d33fb;
        padding: 15px 40px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        border: 2px solid #5d33fb;
    }

        .btn-secondary-custom:hover {
            background: #5d33fb;
            color: #fff;
            text-decoration: none;
        }

    .button-group {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 768px) {
        .subscribe-container {
            padding: 15px;
        }

        .subscribe-hero {
            padding: 35px 20px;
        }

            .subscribe-hero h1 {
                font-size: 28px;
            }

            .subscribe-hero i {
                font-size: 48px;
            }

        .subscribe-card {
            padding: 25px 20px;
        }

        .button-group {
            flex-direction: column;
        }

        .btn-primary-custom,
        .btn-secondary-custom {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="subscribe-container">
    @{
        var status = TempData["SubscribeEmailStatus"] as string ?? "";
        var message = TempData["SubscribeEmailMessage"] as string ?? "";
        var isSuccess = string.Equals(status, "success", StringComparison.OrdinalIgnoreCase);
        var hasMessage = !string.IsNullOrWhiteSpace(message);
    }

    <div class="subscribe-hero">
        <i class="fa @(isSuccess ? "fa-check-circle" : "fa-envelope")" aria-hidden="true"></i>
        <h1>Odber noviniek</h1>
        <p>Vitajte v na&#353;ej newsletterovej komunite</p>
    </div>

    @if (hasMessage)
    {
        if (isSuccess)
        {
            <div class="status-success" role="status">
                <i class="fa fa-check-circle" aria-hidden="true"></i>
                <h3>&#381;iados&#357; bola &#250;spe&#353;ne spracovan&#225;</h3>
                <p>@message</p>
            </div>
        }
        else
        {
            <div class="status-error" role="alert">
                <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
                <h3>Odber sa nepodarilo spracova&#357;</h3>
                <p>@message</p>
            </div>
        }
    }

    @if (isSuccess)
    {
        <div class="subscribe-card">
            <h2><i class="fa fa-envelope-o" aria-hidden="true"></i> &#268;o bude nasledova&#357;?</h2>
            <p>
                Ak v&#225;m pri&#353;iel potvrdzovac&#237; e-mail, otvorte ho a kliknite na potvrdzovac&#237; odkaz.
                A&#382; po potvrden&#237; odkazu bude odber noviniek aktivovan&#253;.
            </p>
            <div class="info-box">
                <h4><i class="fa fa-check-circle" aria-hidden="true"></i> Po aktiv&#225;cii odberu m&#244;&#382;ete dost&#225;va&#357;:</h4>
                <ul>
                    <li><strong>Pravideln&#233; novinky</strong> &#8211; inform&#225;cie o nov&#253;ch produktoch a slu&#382;b&#225;ch</li>
                    <li><strong>Exkluz&#237;vne akcie</strong> &#8211; &#353;peci&#225;lne ponuky pre odberate&#318;ov</li>
                    <li><strong>Zauj&#237;mav&#233; &#269;l&#225;nky</strong> &#8211; tipy pre zdravie a web/IT slu&#382;by</li>
                    <li><strong>Inform&#225;cie o doprave a platb&#225;ch</strong> &#8211; novinky o mo&#382;nostiach n&#225;kupu</li>
                </ul>
            </div>
            <p>
                Ak si budete &#382;ela&#357; odber nesk&#244;r zru&#353;i&#357;, v newsletterov&#253;ch e-mailoch
                n&#225;jdete odkaz na odhl&#225;senie.
            </p>
            <div class="button-group">
                <a href="@Url.Action("Zdravie", "Home")" class="btn-primary-custom">
                    <i class="fa fa-heart" aria-hidden="true"></i> Prezrie&#357; produkty Zdravie
                </a>
                <a href="@Url.Action("ITservis", "Home")" class="btn-secondary-custom">
                    <i class="fa fa-laptop" aria-hidden="true"></i> Web/IT slu&#382;by
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="subscribe-card">
            <h2><i class="fa fa-envelope-o" aria-hidden="true"></i> Odber noviniek</h2>
            @if (hasMessage)
            {
                <p>
                    Pri spracovan&#237; odberu sa vyskytol probl&#233;m. Sk&#250;ste to znova alebo n&#225;s kontaktujte.
                </p>
                <div class="info-box">
                    <h4><i class="fa fa-search" aria-hidden="true"></i> &#268;o m&#244;&#382;ete sk&#250;si&#357;:</h4>
                    <ul>
                        <li>Skontrolujte, &#269;i ste zadali spr&#225;vnu e-mailov&#250; adresu.</li>
                        <li>Ak v&#225;m pri&#353;iel potvrdzovac&#237; e-mail, pou&#382;ite odkaz z neho.</li>
                        <li>Ak odkaz nefunguje, sk&#250;ste sa prihl&#225;si&#357; na odber znova.</li>
                        <li>Ak probl&#233;m pretrv&#225;va, kontaktujte n&#225;s na info@ladowebservis.sk.</li>
                    </ul>
                </div>
            }
            else
            {
                <p>
                    Ak sa chcete prihl&#225;si&#357; na odber noviniek, nav&#353;t&#237;vte na&#353;u hlavn&#250; str&#225;nku
                    a zadajte svoju e-mailov&#250; adresu v p&#228;ti&#269;ke str&#225;nky.
                </p>
                <p>
                    Po zadan&#237; e-mailovej adresy v&#225;m pr&#237;de potvrdzovac&#237; e-mail
                    s odkazom na aktiv&#225;ciu odberu.
                </p>
                <div class="info-box">
                    <h4><i class="fa fa-check-circle" aria-hidden="true"></i> &#268;o v&#225;m prin&#225;&#353;ame:</h4>
                    <ul>
                        <li><strong>Pravideln&#233; novinky</strong> &#8211; inform&#225;cie o nov&#253;ch produktoch a slu&#382;b&#225;ch</li>
                        <li><strong>Exkluz&#237;vne akcie</strong> &#8211; &#353;peci&#225;lne ponuky pre odberate&#318;ov</li>
                        <li><strong>Zauj&#237;mav&#233; &#269;l&#225;nky</strong> &#8211; tipy pre zdravie a web/IT slu&#382;by</li>
                        <li><strong>Inform&#225;cie o doprave a platb&#225;ch</strong> &#8211; novinky o mo&#382;nostiach n&#225;kupu</li>
                    </ul>
                </div>
            }
            <div class="button-group">
                <a href="@Url.Action("Zdravie", "Home")" class="btn-primary-custom">
                    <i class="fa fa-home" aria-hidden="true"></i> Prejs&#357; na hlavn&#250; str&#225;nku
                </a>
                <a href="@Url.Action("Kontakt", "Home")" class="btn-secondary-custom">
                    <i class="fa fa-envelope" aria-hidden="true"></i> Kontaktujte n&#225;s
                </a>
            </div>
        </div>
    }

    <div class="subscribe-card">
        <h2><i class="fa fa-lock" aria-hidden="true"></i> Ochrana osobn&#253;ch &#250;dajov</h2>
        <p>
            Va&#353;e osobn&#233; &#250;daje chr&#225;nime pod&#318;a GDPR. Va&#353;e e-mailov&#233; adresy pou&#382;&#237;vame
            na zasielanie noviniek pod&#318;a udelen&#233;ho s&#250;hlasu. Odber m&#244;&#382;ete kedyko&#318;vek zru&#353;i&#357;.
        </p>
        <p>
            Viac inform&#225;ci&#237; n&#225;jdete v na&#353;ich
            <a href="@Url.Action("Gdpr", "Home")" style="color: #5d33fb; font-weight: 600;">Z&#225;sad&#225;ch ochrany osobn&#253;ch &#250;dajov</a>.
        </p>
    </div>
</div>